<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_liquid_screen"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <include
        android:id="@+id/inheader"
        layout="@layout/layout_toolbar_other" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivForgotten"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="20dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/icn_forgot_password" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvForgottenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mediumPadding"
                android:fontFamily="@font/semibold"
                android:gravity="center"
                android:text="@string/forgotten_your_password"
                android:textColor="@color/black"
                android:textSize="@dimen/largeSize" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvForgottenPasswordDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/mediumPadding"
                android:fontFamily="@font/medium"
                android:gravity="center"
                android:lineSpacingExtra="8dp"
                android:text="@string/forgotten_password_details"
                android:textColor="@color/gray"
                android:textSize="@dimen/extraMediumSize" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/inputLabelStyle"
                android:text="@string/email_address" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/textLayoutStyle"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtEmail"
                    style="@style/inputEditTextStyle"
                    android:hint="@string/email_address"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnResetPassword"
                style="@style/ButtonStyle"
                android:text="@string/reset_password" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
