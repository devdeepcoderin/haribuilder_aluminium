<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_liquid_screen"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <include
        android:id="@+id/inheader"
        layout="@layout/layout_toolbar_other" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/btnVerify">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvVerifyEmailDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:fontFamily="@font/medium"
                    android:gravity="center"
                    android:lineSpacingExtra="8dp"
                    android:text="@string/enter_the_4_digit_code_received_this_number"
                    android:textColor="@color/gray"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/inputLabelStyle"
                    android:text="@string/otp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOtp"
                    style="@style/textLayoutStyle"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtOtp"
                        style="@style/inputEditTextStyle"
                        android:hint="@string/otp"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/inputLabelStyle"
                    android:text="@string/password" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/textLayoutStyle"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtPassword"
                        style="@style/inputEditTextStyle"
                        android:hint="@string/password"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/inputLabelStyle"
                    android:text="@string/confirm_password" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilConformPassword"
                    style="@style/textLayoutStyle"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtConfirmPassword"
                        style="@style/inputEditTextStyle"
                        android:hint="@string/confirm_password"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

        </ScrollView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVerify"
            style="@style/ButtonStyle"
            android:layout_above="@+id/llFooter"
            android:text="@string/verify" />

        <LinearLayout
            android:id="@+id/llFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/normalPadding"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="@dimen/normalPadding">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="@font/semibold"
                android:gravity="center"
                android:text="@string/not_received_code"
                android:textColor="@color/black"
                android:textSize="@dimen/extraMediumSize" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvResend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:fontFamily="@font/semibold"
                android:gravity="center"
                android:text="@string/resend"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/extraMediumSize" />
        </LinearLayout>

    </RelativeLayout>

</LinearLayout>
