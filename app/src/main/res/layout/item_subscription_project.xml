<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvMain"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="5dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="5dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:gravity="center"
            android:visibility="gone"
            android:padding="2dp"
            android:text="@string/recommanded"
            android:textColor="@color/white" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPlan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/smallerSize"
            android:fontFamily="@font/medium"
            android:gravity="center"
            android:lines="2"
            android:text="@string/app_name"
            android:textColor="@color/black"
            android:textSize="@dimen/largeSize" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/smallerSize"
            android:layout_marginEnd="@dimen/smallerSize"
            android:layout_marginBottom="@dimen/largeSize"
            android:fontFamily="@font/medium"
            android:text="Plan"
            android:textColor="@color/gray"
            android:textSize="@dimen/mediumSize" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="@dimen/largeSize"
            android:background="@color/gray_light" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/smallerSize"
            android:fontFamily="@font/medium"
            android:text="50$"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/largeSize"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/smallerSize"
            android:layout_marginEnd="@dimen/smallerSize"
            android:fontFamily="@font/medium"
            android:text="@string/app_name"
            android:textColor="@color/black"
            android:textSize="@dimen/mediumSize" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/smallerSize"
            android:layout_marginEnd="@dimen/smallerSize"
            android:layout_marginBottom="@dimen/smallerSize"
            android:fontFamily="@font/medium"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/gray"
            android:textSize="@dimen/mediumSize"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>