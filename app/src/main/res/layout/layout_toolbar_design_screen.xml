<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tlGeneral"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="@drawable/img_toolbar_bg"
    app:contentInsetLeft="0dp"
    app:contentInsetStart="0dp"
    app:layout_collapseMode="pin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="1">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/imgBtnBack"
            style="@style/btnToolbarBack" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvItemNumber"
            style="@style/tvToolbarTitle"
            android:layout_marginEnd="@dimen/smallPadding"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivUndo"
            style="@style/ivToolbarIcon"
            android:layout_weight="1"
            android:visibility="visible"
            app:srcCompat="@drawable/icn_undo" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivRedo"
            style="@style/ivToolbarIcon"
            android:layout_weight="1"
            android:visibility="visible"
            app:srcCompat="@drawable/icn_redo" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivCreate"
            style="@style/ivToolbarIcon"
            android:visibility="visible"
            app:srcCompat="@drawable/icn_new_item" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivOptions"
            style="@style/ivToolbarIcon"
            android:layout_gravity="center"
            android:layout_marginEnd="@dimen/smallPadding"
            android:layout_weight="1"
            android:visibility="visible"
            app:srcCompat="@drawable/icn_options" />
    </LinearLayout>

</androidx.appcompat.widget.Toolbar>

