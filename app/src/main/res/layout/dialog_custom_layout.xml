<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include android:id="@+id/inheader"
        layout="@layout/layout_dialog_title" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/mediumSize"
        android:paddingEnd="@dimen/mediumSize"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normalPadding"
            android:layout_marginBottom="@dimen/normalPadding"
            android:textColor="@color/gray"
            android:text="@string/app_name" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:gravity="end"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNegative"
                style="@style/btnDialogStyle"
                android:textColor="@color/red"
                android:text="No"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPositive"
                style="@style/btnDialogStyle"
                android:text="Yes"
                android:textColor="@color/colorPrimary"/>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
