<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_liquid_screen"
    android:orientation="vertical">

    <include
        android:id="@+id/inheader"
        layout="@layout/layout_toolbar_other" />

    <androidx.appcompat.widget.AppCompatTextView
        style="@style/tvSettingTitleStyle"
        android:text="@string/app_settings" />

    <com.google.android.material.card.MaterialCardView
        style="@style/cardViewStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="0dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/glass_radius_md"
        app:cardElevation="@dimen/glass_elevation"
        app:strokeColor="@color/glass_border_dark"
        app:strokeWidth="@dimen/glass_stroke">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPriceSettings"
                style="@style/tvSettingsScreenStyle"
                android:drawableStart="@drawable/icn_default_setting"
                android:text="@string/default_setting" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.appcompat.widget.AppCompatTextView
        style="@style/tvSettingTitleStyle"
        android:padding="@dimen/_4sdp"
        android:text="@string/other" />

    <com.google.android.material.card.MaterialCardView
        style="@style/cardViewStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="0dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/glass_radius_md"
        app:cardElevation="@dimen/glass_elevation"
        app:strokeColor="@color/glass_border_dark"
        app:strokeWidth="@dimen/glass_stroke">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="@dimen/smallPadding"
            android:paddingBottom="@dimen/smallPadding">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPP"
                style="@style/tvSettingsScreenStyle"
                android:drawableStart="@drawable/icn_pp"
                android:text="@string/privacy_policy" />

            <include layout="@layout/layout_divider_horizontal" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvShareApp"
                style="@style/tvSettingsScreenStyle"
                android:drawableStart="@drawable/icn_share"
                android:text="@string/share_app" />

            <include layout="@layout/layout_divider_horizontal" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvRateUs"
                style="@style/tvSettingsScreenStyle"
                android:drawableStart="@drawable/icn_rate"
                android:text="@string/rate_us" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
