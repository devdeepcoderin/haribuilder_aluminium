<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tlGeneral"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="@drawable/img_toolbar_bg"
    app:contentInsetLeft="0dp"
    app:contentInsetStart="0dp"
    app:layout_collapseMode="pin">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/imgBtnBack"
            style="@style/btnToolbarBack" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitle"
            style="@style/tvToolbarTitle"
            android:layout_centerHorizontal="true"
            android:layout_marginEnd="@dimen/largestPadding"
            android:layout_alignEnd="@+id/ivThirdRight"
            android:layout_toEndOf="@+id/imgBtnBack"
            android:text="@string/app_name" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivThirdRight"
            style="@style/ivToolbarIcon"
            android:layout_toStartOf="@+id/ivSecondRight"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivSecondRight"
            style="@style/ivToolbarIcon"
            android:visibility="gone"
            android:layout_toStartOf="@+id/ivRight"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivRight"
            style="@style/ivToolbarIcon"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/mediumPadding"
            android:visibility="visible" />
    </RelativeLayout>

</androidx.appcompat.widget.Toolbar>

