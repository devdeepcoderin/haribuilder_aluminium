<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_bottom_sheet"
    android:orientation="vertical"
    android:paddingBottom="@dimen/normalPadding">

    <include
        android:id="@+id/inheader"
        layout="@layout/layout_dialog_title" />

    <com.deepcoder.hbalum.utils.view.CustomRecyclerView
        android:id="@+id/rvData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/smallPadding"
        app:gird_span="2"
        app:list_orientation="vertical"
        app:list_type="grid" />

</LinearLayout>
