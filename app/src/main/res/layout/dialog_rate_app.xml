<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@android:color/transparent"
    android:padding="@dimen/normalPadding">

    <RelativeLayout
        android:id="@+id/rlMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:animateLayoutChanges="true">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/glass_surface_strong"
            app:cardCornerRadius="@dimen/glass_radius_lg"
            app:cardElevation="@dimen/glass_elevation"
            app:strokeColor="@color/glass_border_dark"
            app:strokeWidth="@dimen/glass_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/normalPadding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/tinyPadding">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@mipmap/ic_launcher" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/smallPadding"
                        android:fontFamily="@font/semibold"
                        android:text="@string/app_name"
                        android:textSize="@dimen/largeSize" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/tinyPadding"
                    android:fontFamily="@font/regular"
                    android:gravity="center"
                    android:paddingLeft="@dimen/mediumPadding"
                    android:paddingRight="@dimen/mediumPadding"
                    android:text="@string/rate_app_msg"
                    android:textAlignment="center"
                    android:textColor="@color/gray" />

                <LinearLayout
                    android:id="@+id/llRateApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mediumPadding"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvLater"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_button_soft"
                        android:fontFamily="@font/medium"
                        android:gravity="center"
                        android:layout_marginEnd="@dimen/miniPadding"
                        android:padding="@dimen/smallPadding"
                        android:text="@string/later"
                        android:textColor="@color/gray"
                        android:textSize="@dimen/normalSize" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvRateApp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_button_primary"
                        android:fontFamily="@font/semibold"
                        android:gravity="center"
                        android:layout_marginStart="@dimen/miniPadding"
                        android:padding="@dimen/smallPadding"
                        android:text="@string/rate_now"
                        android:textColor="@color/white"
                        android:textSize="@dimen/normalSize" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_margin="@dimen/microPadding"
        android:src="@drawable/icn_close"
        android:tint="@color/gray"
        android:visibility="gone" />

</RelativeLayout>
