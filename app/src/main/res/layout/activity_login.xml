<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_liquid_screen"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/llFooter"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/smallPadding"
        android:paddingEnd="@dimen/smallPadding">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/normalPadding"
            android:layout_marginEnd="@dimen/normalPadding"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/glass_radius_lg"
            app:cardElevation="@dimen/glass_elevation"
            app:strokeColor="@color/glass_border_dark"
            app:strokeWidth="@dimen/glass_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/normalPadding"
                android:paddingBottom="@dimen/normalPadding">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/inputLabelStyle"
                    android:text="@string/email_address" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/llEmail"
                    style="@style/textLayoutStyle"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtEmail"
                        style="@style/inputEditTextStyle"
                        android:hint="@string/email_address"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/inputLabelStyle"
                    android:text="@string/password" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/textLayoutStyle"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtPassword"
                        style="@style/inputEditTextStyle"
                        android:hint="@string/password"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSignIn"
                    style="@style/ButtonStyle"
                    android:text="@string/btn_sign_in" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvForgot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/smallPadding"
                    android:background="?android:attr/selectableItemBackground"
                    android:fontFamily="@font/regular"
                    android:gravity="center"
                    android:text="@string/forgot_password_question"
                    android:textColor="@color/black"
                    android:textSize="@dimen/normalSize" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/llFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/normalPadding"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/normalPadding"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_glass_fab_label"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/smallPadding">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="@font/semibold"
            android:gravity="center"
            android:text="@string/don_t_have_an_account"
            android:textColor="@color/black"
            android:textSize="@dimen/extraMediumSize" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSignUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:fontFamily="@font/semibold"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:text="@string/sign_up"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/extraMediumSize" />
    </LinearLayout>

</RelativeLayout>
