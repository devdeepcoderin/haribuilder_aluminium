<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <include
        android:id="@+id/inheader"
        layout="@layout/layout_dialog_title" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout style="@style/llProjectDetailStyle">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvProjectNameTitle"
                style="@style/tvTitleStyle"
                android:text="@string/project_name" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvProjectName"
                style="@style/tvSubTitleStyle" />
        </LinearLayout>

        <include layout="@layout/layout_divider_horizontal" />

        <LinearLayout style="@style/llProjectDetailStyle">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvQtyTitle"
                style="@style/tvTitleStyle"
                android:text="@string/total_item_quantity" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvQty"
                style="@style/tvSubTitleStyle" />
        </LinearLayout>

        <include layout="@layout/layout_divider_horizontal" />

        <LinearLayout style="@style/llProjectDetailStyle">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTotalGlassAreaTitle"
                style="@style/tvTitleStyle"
                android:text="@string/total_profile_length" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTotalGlassArea"
                style="@style/tvSubTitleStyle" />
        </LinearLayout>

        <include
            layout="@layout/layout_divider_horizontal" />

        <LinearLayout style="@style/llProjectDetailStyle">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTotalProfileTitle"
                style="@style/tvTitleStyle"
                android:text="@string/total_glass_area" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTotalProfile"
                style="@style/tvSubTitleStyle" />
        </LinearLayout>

        <include android:id="@+id/inHorizontal"
            layout="@layout/layout_divider_horizontal" />

        <LinearLayout style="@style/llProjectDetailStyle">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTotalItemTitle"
                style="@style/tvTitleStyle"
                android:text="@string/total_item_area" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTotalItem"
                style="@style/tvSubTitleStyle" />
        </LinearLayout>

        <include android:id="@+id/inBottomButtons"
            layout="@layout/layout_bottom_buttons" />
    </LinearLayout>
</LinearLayout>
