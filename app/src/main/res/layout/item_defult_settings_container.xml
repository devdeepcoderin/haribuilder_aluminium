<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvDefaultSettingItemTitle"
        style="@style/tvSettingTitleStyle"
        android:text="@string/app_name" />

    <com.google.android.material.card.MaterialCardView
        style="@style/cardViewStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/glass_radius_md"
        app:cardElevation="@dimen/glass_elevation"
        app:strokeColor="@color/glass_border_dark"
        app:strokeWidth="@dimen/glass_stroke">

        <LinearLayout
            android:id="@+id/llDefaultSettingRowContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
